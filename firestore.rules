rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Household profile - only the owning user can read or write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Gamification state (XP, streak, badges, completed tasks) - owner only.
      match /gamification/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Alert history - the owning user can read their own log and create new
      // entries (written automatically when an alert fires). No edits/deletes.
      match /alertHistory/{alertId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Alert zones - readable by any signed-in user (required for the client-side
    // geofencing check in AlertsScreen.js). Writable by any signed-in user only
    // because this prototype's "Simulate Nearby Alert" button creates zones
    // directly from the client for demo purposes. In a real deployment, zone
    // creation should go through a trusted backend (e.g. a Cloud Function using
    // the Admin SDK, fed by an official emergency data feed) rather than open
    // client writes.
    match /alertZones/{zoneId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Deny everything else by default (e.g. the ad-hoc "_connection_test"
    // collection used earlier to verify the Firebase connection).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
