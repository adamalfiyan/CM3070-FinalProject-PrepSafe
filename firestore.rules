rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Household profile - only the owning user can read or write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Gamification state (XP, streak, badges, completed tasks) - owner only.
      match /gamification/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Alert history - the owning user can read their own log and create new entries
      match /alertHistory/{alertId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Alert zones allow open client writes for simulation but must restrict to trusted backend in production.
    match /alertZones/{zoneId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Deny everything else by default (e.g. the ad-hoc "_connection_test")
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
